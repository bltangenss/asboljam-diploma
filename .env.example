# Copy to .env. Local start scripts read this file without executing it.
# local preserves the SQLite/HTTP demonstration. production validates HTTPS,
# secure cookies and an explicit PostgreSQL URL before opening the API database.
ASBOLJAM_ENV=local
# Compose requires a password generated with secrets.token_urlsafe(32).
POSTGRES_PASSWORD=
# Local-only seed password (12+ characters). Blank => generated/displayed once.
# Must be unset in production. Never run demo seed against a production database.
DEMO_PASSWORD=
# Leave DATABASE_URL unset to use data/asboljam.sqlite locally.
# DATABASE_URL=postgresql+psycopg://USER:URL_ENCODED_PASSWORD@localhost:5432/asboljam
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
COOKIE_SECURE=false
# For production: explicit HTTPS origins without trailing slash, path, credentials
# or wildcard; COOKIE_SECURE=true. Do not use placeholder database credentials.
# ALLOWED_ORIGINS=https://app.example.org
# See docs/commercial/SECURITY_RUNBOOK_RU.md; production mode does not enable REAL import.
ORGANIZATION_NAME=AsBoljam Demo
LOKY_MAX_CPU_COUNT=1
IMPORT_MAX_BYTES=20971520
IMPORT_MAX_ROWS=250000
