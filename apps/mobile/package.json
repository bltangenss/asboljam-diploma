    "react-native": "0.83.10",
    "react-native-safe-area-context": "5.6.2"
  },
  "devDependencies": {
    "@types/node": "24.12.0",
    "@types/react": "19.2.14",
    "typescript": "5.9.3"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  }
