FROM python:3.13-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 LOKY_MAX_CPU_COUNT=1
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home appuser
COPY requirements.lock ./requirements.lock
RUN pip install --no-cache-dir -r requirements.lock
COPY --chown=appuser:appuser apps/api ./apps/api
COPY --chown=appuser:appuser apps/worker ./apps/worker
COPY --chown=appuser:appuser database ./database
COPY --chown=appuser:appuser scripts/seed_demo.py scripts/backup_db.py ./scripts/
COPY --chown=appuser:appuser data/raw ./data/raw
RUN chown -R appuser:appuser /app/data
USER appuser
EXPOSE 8000
CMD ["python", "-m", "uvicorn", "apps.api.main:app", "--host", "0.0.0.0", "--port", "8000", "--no-access-log"]
