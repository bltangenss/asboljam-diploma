# Production settings for docker-compose.yml + infra/compose.prod.yml.
# Copy to a private .env on the server (never commit it). Names and placeholders only.
ASBOLJAM_ENV=production
# Public domain; Caddy obtains its certificate automatically (DNS A record + ports 80/443).
ASBOLJAM_SITE_ADDRESS=app.example.kz
# Exactly the HTTPS origin users open; no trailing slash, path or wildcard.
ALLOWED_ORIGINS=https://app.example.kz
COOKIE_SECURE=true
# Generate on the server: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=
# Must stay unset in production: demo seed is refused.
DEMO_PASSWORD=
WORKER_CALCULATION_TIMEOUT_SECONDS=900
LOKY_MAX_CPU_COUNT=1
IMPORT_MAX_BYTES=20971520
IMPORT_MAX_ROWS=250000
# Optional local overrides of the published ports (defaults 80 and 443).
# ASBOLJAM_HTTP_PORT=80
# ASBOLJAM_HTTPS_PORT=443
